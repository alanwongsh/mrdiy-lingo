# ---------------------------------------------------------------------------
# Mr DIY Lingo — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# ---------------------------------------------------------------------------


# ── Database (required for db:seed, db:migrate, db:reset) ───────────────────
# Found in: Supabase Dashboard → Project Settings → Database → Connection string
# Use the "Transaction" pooler URL (port 6543)
DATABASE_URL=


# ── Supabase (required for the app) ─────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Project URL (e.g. https://abcdefghij.supabase.co)
NEXT_PRIVATE_SUPABASE_URL=

# Publishable / anon key (safe for browser use)
NEXT_PRIVATE_SUPABASE_PUBLISHABLE_KEY=


# ── Auth / Embed token (required) ───────────────────────────────────────────
# Shared HMAC-SHA256 secret between Joget and Lingo.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOGET_EMBED_SECRET=

# Space-separated origins allowed to iframe this app. Defaults to * (all).
# JOGET_FRAME_ANCESTORS=https://joget.example.com

# Dev-only: allow minting embed tokens from the sign-in page.
# Set to true for local dev. NEVER enable in production.
# EMBED_ALLOW_DEV=true


# ── Access Control ───────────────────────────────────────────────────────────
# Comma-separated Joget usernames, emails, or employee IDs with superadmin access.
# e.g. LINGO_SUPERADMINS=ahmad,lee@example.com,E10293
# LINGO_SUPERADMINS=


# ── Translation Provider ─────────────────────────────────────────────────────
# mymemory  — free MyMemory API, no key required (default)
# mock      — offline stub, prefixes text with [lang-code]
TRANSLATION_PROVIDER=mymemory


# ── Seed helpers (db:seed only) ──────────────────────────────────────────────
# If set, db:seed will upsert this user as a superadmin hub_user.
# LINGO_SEED_ADMIN_EMAIL=admin@mrdiy.com
# LINGO_SEED_ADMIN_NAME=Lingo Admin


# ── db:reset safety guard ────────────────────────────────────────────────────
# Must be "yes" to allow npm run db:reset to drop and recreate all tables.
# Leave blank in production.
# LINGO_RESET_CONFIRM=yes


# ── Network / SSL (optional) ─────────────────────────────────────────────────
# Set to true if your corporate network intercepts HTTPS with a custom CA
# and you see "fetch failed" in local dev. NEVER enable in production.
# SUPABASE_INSECURE_SSL=true
